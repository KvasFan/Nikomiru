<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Nikomiru — third-party licenses</title>
    <style>
        :root { color-scheme: light dark; }
        body { font-family: system-ui, sans-serif; line-height: 1.5; margin: 0; padding: 0 16px; }
        main { max-width: 860px; margin: 0 auto; padding: 24px 0 48px; }
        h1 { font-size: 1.6rem; }
        ul.crates { columns: 2; padding-left: 1.2em; }
        pre { white-space: pre-wrap; max-height: 260px; overflow-y: auto; padding: 12px;
              border: 1px solid color-mix(in srgb, currentColor 25%, transparent); border-radius: 6px; }
        @media (max-width: 600px) { ul.crates { columns: 1; } }
    </style>
</head>
<body>
<main>
    <h1>Nikomiru — third-party licenses</h1>
    <p>Nikomiru is licensed under GPL-3.0-only and uses the projects listed below under their own licenses.</p>

    <h2>Overview</h2>
    <ul>
        {{#each overview}}
        <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
        {{/each}}
    </ul>

    <h2>License texts</h2>
    {{#each licenses}}
    <section>
        <h3 id="{{id}}">{{name}}</h3>
        <ul class="crates">
            {{#each used_by}}
            <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
            {{/each}}
        </ul>
        <pre>{{text}}</pre>
    </section>
    {{/each}}
</main>
</body>
</html>
